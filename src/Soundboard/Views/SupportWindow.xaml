<Window x:Class="Soundboard.Views.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support"
        Width="760"
        Height="600"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ticket list -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12">
                    <TextBlock Text="Support" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button Content="+ New Request" Style="{StaticResource AccentButton}" Command="{Binding StartNewTicketCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tickets}" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusLabel}" Opacity="0.6" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Thread / composer / empty state -->
        <Grid Grid.Column="1" Margin="24">

            <TextBlock Text="Select a request, or start a new one." Opacity="0.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"/>

            <StackPanel Visibility="{Binding IsComposingNewTicket, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="New Support Request" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="Subject" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewTicketSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Message" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewTicketMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="160" Margin="0,0,0,12"/>

                <Button Content="Send" Style="{StaticResource AccentButton}" Command="{Binding CreateTicketCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" HorizontalAlignment="Left" Width="120"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>

            <Grid Visibility="{Binding SelectedTicket, Converter={StaticResource NullToCollapsed}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SelectedTicket.Subject}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,8" Margin="0,0,0,10" MaxWidth="440"
                                        Background="{DynamicResource SurfaceElevatedBrush}" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="10" Opacity="0.75" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Support"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                            <Setter Property="Text" Value="You"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=g}" FontSize="9" Opacity="0.6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>

                <!-- Resolved: reply box is closed, prompt to start a new request instead. -->
                <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12"
                        Visibility="{Binding SelectedTicket.IsResolved, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="This request has been resolved." Opacity="0.7" VerticalAlignment="Center"/>
                        <Button Content="+ New Request" Style="{StaticResource ToolbarButton}" Command="{Binding StartNewTicketCommand}" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Open/In Progress: normal reply composer. -->
                <Grid Grid.Row="3" Visibility="{Binding SelectedTicket.IsResolved, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButton}" Command="{Binding SendReplyCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" VerticalAlignment="Bottom" Width="90"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
