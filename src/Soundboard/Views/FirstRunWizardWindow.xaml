<Window x:Class="Soundboard.Views.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonar Setup"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="32" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

        <!-- Step 1: Progress checklist -->
        <StackPanel Visibility="{Binding ShowProgressStep, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Welcome to Sonar" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="24"
                           Visibility="{Binding FoldersDone, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Creating folders..." Opacity="{Binding FoldersDone, Converter={StaticResource BoolToOpacity}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="24"
                           Visibility="{Binding DevicesDone, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Checking audio devices..." Opacity="{Binding DevicesDone, Converter={StaticResource BoolToOpacity}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="24"
                           Visibility="{Binding VbCableCheckDone, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Looking for VB-Cable..." Opacity="{Binding VbCableCheckDone, Converter={StaticResource BoolToOpacity}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="24"
                           Visibility="{Binding SettingsDone, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Creating settings..." Opacity="{Binding SettingsDone, Converter={StaticResource BoolToOpacity}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="24"
                           Visibility="{Binding DemoSoundsDone, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Importing demo sounds..." Opacity="{Binding DemoSoundsDone, Converter={StaticResource BoolToOpacity}}"/>
            </StackPanel>

            <Button Content="Next" Style="{StaticResource ToolbarButton}" IsEnabled="{Binding NextEnabled}"
                    Command="{Binding NextCommand}" HorizontalAlignment="Right" Margin="0,24,0,0" Width="100"/>
        </StackPanel>

        <!-- Step 2: VB-Cable install prompt (only shown if not detected) -->
        <StackPanel Visibility="{Binding ShowVbCablePromptStep, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Virtual audio device not found." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="Install VB-Cable?" Opacity="0.8" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="VB-Cable lets Sonar send audio into Discord, games, and OBS as if it were a microphone. This opens the official VB-Audio download page — download and run their installer, then come back here."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <Button Content="Install" Style="{StaticResource ToolbarButton}" Command="{Binding InstallVbCableCommand}"
                    HorizontalAlignment="Left" Width="140" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding VbCableRecheckMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip for now" Style="{StaticResource ToolbarButton}" Command="{Binding SkipVbCableCommand}"/>
                <Button Content="I've installed it" Style="{StaticResource ToolbarButton}" Command="{Binding RecheckVbCableCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 3: Complete summary -->
        <StackPanel Visibility="{Binding ShowCompleteStep, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Setup Complete" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

            <TextBlock Text="Default Output" Opacity="0.6" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding DefaultOutputSummary}" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="Monitoring" Opacity="0.6" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding MonitoringSummary}" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="Regular microphone" Opacity="0.6" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding MicrophoneSummary}" FontWeight="SemiBold" Margin="0,0,0,24" TextWrapping="Wrap"/>

            <TextBlock Text="You can change any of this later from Settings." Opacity="0.6" Margin="0,0,0,24" TextWrapping="Wrap"/>

            <Button Content="Finish" Style="{StaticResource ToolbarButton}" Command="{Binding FinishCommand}"
                    HorizontalAlignment="Right" Width="100"/>
        </StackPanel>

    </Grid>
</Window>
