<Window x:Class="Soundboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Soundboard.ViewModels"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="Sonar"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Not part of the visual tree — TaskbarIcon renders itself via the Win32 shell
             notification area, not on-screen WPF layout, so it's safe to keep as a plain
             resource rather than a child element. x:Name still generates a code-behind field
             for it here, same as any other named FrameworkElement. -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Assets/icon.ico"
                        ToolTipText="Sonar"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Sonar" Click="TrayShowMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="TrayExitMenuItem_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- VirtualizingWrapPanel (WpfToolkit.Controls) throws at measure time unless
             VirtualizingPanel.IsVirtualizing="True" is also set on the ItemsControl — it has no
             graceful non-virtualizing fallback mode. So Performance Mode on/off can't just flip
             that one attached property; the ItemsPanelTemplate itself has to swap between this
             and the plain WrapPanel below via the Style.Triggers on each ItemsControl. -->
        <ItemsPanelTemplate x:Key="PlainSoundGridPanel">
            <WrapPanel ItemWidth="{DynamicResource ButtonSize}" ItemHeight="{DynamicResource ButtonSize}"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VirtualizedSoundGridPanel">
            <vwp:VirtualizingWrapPanel ItemSize="{Binding Source={StaticResource ButtonSize}, Converter={StaticResource DoubleToUniformSize}}"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PlainSoundListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VirtualizedSoundListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar + update banner -->
        <StackPanel Grid.Row="0">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="SOUNDS ▾" Style="{StaticResource ToolbarButton}" Click="SoundsMenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🎲 Random Sound" Command="{Binding PlayRandomSoundCommand}"/>
                                <MenuItem Header="🎉 Sound Party" Command="{Binding PlaySoundPartyCommand}"/>
                                <MenuItem Header="🔤 First Sound (A-Z)" Command="{Binding PlayFirstSoundCommand}"/>
                                <MenuItem Header="📋 Sound Count" Command="{Binding ShowSoundCountCommand}"/>
                                <Separator/>
                                <MenuItem Header="Add Sounds" Command="{Binding ImportSoundsCommand}"/>
                                <MenuItem Header="Rescan" Command="{Binding RescanLibraryCommand}"/>
                                <Separator/>
                                <MenuItem Header="Stop All" Command="{Binding StopAllCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="MARKETPLACE" Style="{StaticResource ToolbarButton}" Command="{Binding OpenPluginMarketplaceCommand}"/>
                </StackPanel>

                <!-- Search: persistent icon, Ctrl+K hint + placeholder shown only while empty
                     (an overlay of hit-test-invisible TextBlocks over a transparent-background
                     TextBox, replacing the old VisualBrush placeholder hack with something that
                     can also host the Ctrl+K hint in the same pass). -->
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource SearchBox}" Padding="34,8,66,8"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <Path Data="{StaticResource IconSearch}" Stretch="Uniform" Width="13" Height="13"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    <TextBlock Text="Search sounds, tags, categories..." FontFamily="{DynamicResource MonoFontFamily}" IsHitTestVisible="False" Opacity="0.5"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0"
                               Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisible}}"/>
                    <Border IsHitTestVisible="False" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,2"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                            Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisible}}">
                        <TextBlock Text="CTRL+K" FontFamily="{DynamicResource MonoFontFamily}" Opacity="0.5" FontSize="9.5"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowSettingsCommand}"
                            ToolTip="Output &amp; microphone devices — open Audio settings" Padding="8,6" Margin="0,0,6,0">
                        <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="14" Height="14"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleMasterMuteCommand}"
                            ToolTip="Master volume — click to mute/unmute" Padding="8,6" Margin="0,0,8,0">
                        <Grid>
                            <Path Data="{StaticResource IconSpeaker}" Stretch="Uniform" Width="14" Height="14"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="{Binding MasterMuted, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <Path Data="{StaticResource IconSpeakerMuted}" Stretch="Uniform" Width="14" Height="14"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="{Binding MasterMuted, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Button>
                    <Slider Width="70" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="Master volume"/>
                    <TextBlock Text="{Binding ActivePlaybackCount, StringFormat={}{0} playing}" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner -->
        <Border Background="{DynamicResource AccentBrush}" Padding="16,10"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding UpdateVersionText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}"
                        Content="Update Now"
                        Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolean}}"
                        Margin="12,0"/>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource ToolbarButton}" ToolTip="Dismiss"
                        Command="{Binding DismissUpdateCommand}"
                        IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolean}}"
                        Margin="0" Width="32"/>
            </Grid>
        </Border>

        <!-- Admin broadcast banner -->
        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2" Padding="16,10"
                Visibility="{Binding HasAdminMessage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding AdminMessageText, StringFormat={}📢 {0}}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource ToolbarButton}" ToolTip="Dismiss"
                        Command="{Binding DismissAdminMessageCommand}"
                        Margin="12,0,0,0" Width="32"/>
            </Grid>
        </Border>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToSidebarColumnWidth}}" MinWidth="64"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Brand + collapse toggle -->
                    <Grid DockPanel.Dock="Top" Margin="12,12,12,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <Rectangle Width="12" Height="12" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="SONAR" FontFamily="{DynamicResource BrandFontFamily}" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Toggle sidebar" Padding="8,6" Margin="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconMenu}" Stretch="Uniform" Width="14" Height="14"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>

                    <!-- Account + version footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12">
                        <Separator Margin="0,0,0,10" Background="{DynamicResource BorderBrush}"/>
                        <Button Command="{Binding OpenAccountCommand}" Style="{StaticResource SidebarButton}" ToolTip="{Binding AccountButtonText}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Picked profile picture (LocalAvatarStore) when one exists, same
                                     square-geometry outline dot as every other sidebar row otherwise. -->
                                <Rectangle Width="16" Height="16" VerticalAlignment="Center"
                                           Visibility="{Binding AccountAvatarPath, Converter={StaticResource NullToCollapsed}}">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding AccountAvatarPath}" Stretch="UniformToFill"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Width="6" Height="6" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" VerticalAlignment="Center" Margin="2,0,0,0"
                                           Visibility="{Binding AccountAvatarPath, Converter={StaticResource NullToVisible}}"/>
                                <TextBlock Text="{Binding AccountButtonText}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding AppVersionText}" FontFamily="{DynamicResource MonoFontFamily}" Opacity="0.4" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0,12,12">
                            <TextBlock Text="LIBRARY" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="10.5" Margin="4,0,0,10" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <Button Command="{Binding ShowHomeCommand}" ToolTip="Home" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="HOME" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowAllSoundsCommand}" ToolTip="All Sounds" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllSoundsActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="ALL SOUNDS" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllSoundsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowFavoritesViewCommand}" ToolTip="Favorites" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritesActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="FAVORITES" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritesActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowRecentViewCommand}" ToolTip="Recently Used" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="RECENTLY USED" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowMostPlayedViewCommand}" ToolTip="Most Played" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMostPlayedActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="MOST PLAYED" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMostPlayedActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowVoiceChangerViewCommand}" ToolTip="Voice Changer" Style="{StaticResource SidebarButton}"
                                    Visibility="{Binding IsVoiceChangerInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoiceChangerNavActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="VOICE CHANGER" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoiceChangerNavActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowPluginsPanelCommand}" ToolTip="Plugins" Style="{StaticResource SidebarButton}"
                                    Visibility="{Binding HasPluginPanels, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPluginsNavActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="PLUGINS" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Margin="12,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPluginsNavActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Folders — a full list doesn't fit a 64px icon rail, so this whole
                                 section (not just labels) hides when collapsed, same convention as
                                 a typical activity-bar-style nav. -->
                            <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid Margin="4,20,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FOLDERS" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="10.5" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ NEW" Style="{StaticResource ToolbarButton}" Command="{Binding AddFolderCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}"
                                                    Command="{Binding DataContext.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ContextMenuOpening="FolderButton_ContextMenuOpening">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="13" Height="13"
                                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"/>
                                                </StackPanel>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Delete Folder" Name="DeleteFolderMenuItem"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"/>

            <!-- Virtualized sound grid -->
            <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">

                <!-- Home dashboard -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32"
                              Visibility="{Binding ShowHomeTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                        <TextBlock Text="HOME" FontFamily="{DynamicResource BrandFontFamily}" FontSize="24" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActivePlaybackCount, StringFormat={}{0} sounds playing right now}" FontFamily="{DynamicResource MonoFontFamily}" Opacity="0.6" Margin="0,0,0,28"/>

                        <!-- Quick Actions -->
                        <TextBlock Text="QUICK ACTIONS" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,28">
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ImportSoundsCommand}" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAdd}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/>
                                    <TextBlock Text="ADD SOUND"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFolderCommand}" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,8,0"/>
                                    <TextBlock Text="CREATE FOLDER"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowVoiceChangerViewCommand}" Padding="14,10" Margin="0,0,10,10"
                                    Visibility="{Binding IsVoiceChangerInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconMic}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0"/>
                                    <TextBlock Text="VOICE CHANGER"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ImportCollectionCommand}" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconImport}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0"/>
                                    <TextBlock Text="IMPORT COLLECTION"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowSettingsCommand}" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/>
                                    <TextBlock Text="SETTINGS"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Active Playback -->
                        <StackPanel Visibility="{Binding HasActivePlayback, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,28">
                            <TextBlock Text="ACTIVE PLAYBACK" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ActivePlaybackItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SoundName}" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Height="4" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                                    <Button ToolTip="Pause/Resume"
                                                            Command="{Binding TogglePauseCommand}" Style="{StaticResource ToolbarButton}" Padding="8,4" Margin="0,0,6,0">
                                                        <Grid>
                                                            <Path Data="{StaticResource IconPause}" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}"
                                                                  Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                            <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}"
                                                                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button ToolTip="Stop" Command="{Binding StopCommand}" Style="{StaticResource ToolbarButton}" Padding="8,4">
                                                        <Path Data="{StaticResource IconStop}" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Recently Played + Favorites -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECENTLY PLAYED" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Nothing played yet." Opacity="0.4" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding RecentlyPlayedHome.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding RecentlyPlayedHome}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SoundButtonViewModel}">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Background="{Binding Sound.Color, Converter={StaticResource ColorToBrush}}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DurationText}" Opacity="0.5" FontSize="10"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{Binding IsFavorite, Converter={StaticResource BoolToGlyph}, ConverterParameter='⭐|☆'}"
                                                            ToolTip="Toggle favorite"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Padding="6,4" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="3" Content="▶" ToolTip="Play" Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FAVORITES" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="No favorites yet — star a sound to pin it here." Opacity="0.4" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding FavoritesHome.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding FavoritesHome}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SoundButtonViewModel}">
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Background="{Binding Sound.Color, Converter={StaticResource ColorToBrush}}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DurationText}" Opacity="0.5" FontSize="10"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="⭐" ToolTip="Toggle favorite"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" Padding="6,4" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="3" Content="▶" ToolTip="Play" Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Deliberately NOT one big outer ScrollViewer around the whole pane (like Home's
                     above) — the sound grid/list below need their OWN dedicated ScrollViewer with
                     CanContentScroll="True" so VirtualizingPanel.IsVirtualizing can actually take
                     effect (an ancestor ScrollViewer without CanContentScroll gives its content
                     PositiveInfinity available height, which forces full realization regardless
                     of panel type — virtualization would silently do nothing under one). The
                     plugin-tile strip and toolbar stay pinned above via DockPanel.Dock="Top",
                     same as before, just anchored to this DockPanel instead of an outer scroller. -->
                    <DockPanel LastChildFill="True" Margin="16"
                               Visibility="{Binding ShowSoundGrid, Converter={StaticResource BoolToVisibility}}">
                        <!-- Plugin tile strip — only ever visible alongside the sound grid, never
                             the Voice Changer/Plugins panel tabs, and only when at least one
                             plugin has actually registered a tile via sonar.addTile. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,16"
                                Visibility="{Binding HasPluginTiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="🧩 PLUGIN TILES" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PluginTiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PluginTileViewModel}">
                                            <Button Command="{Binding InvokeCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Library toolbar: sort, favorites filter, tags filter, view mode, import.
                             Folder filtering already lives in the sidebar's Folders section, so it's
                             deliberately not duplicated here. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Width="150" Margin="0,0,10,0"
                                      ItemsSource="{Binding SortModes}"
                                      SelectedItem="{Binding SortMode}"
                                      ToolTip="Sort by"/>

                            <Button Grid.Column="1" Margin="0,0,10,0"
                                    Command="{Binding ToggleFavoritesFilterCommand}"
                                    ToolTip="Show favorites only">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowFavorites}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconStar}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="FAVORITES" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <ComboBox Grid.Column="2" Width="150" Margin="0,0,4,0"
                                      ItemsSource="{Binding AllTags}"
                                      SelectedItem="{Binding SelectedTagFilter}"
                                      Visibility="{Binding AllTags.Count, Converter={StaticResource CountToVisibility}}"
                                      ToolTip="Filter by tag"/>
                            <Button Grid.Column="3" Style="{StaticResource LinkButton}"
                                    Command="{Binding ClearTagFilterCommand}"
                                    Visibility="{Binding SelectedTagFilter, Converter={StaticResource NullToCollapsed}}"
                                    ToolTip="Clear tag filter" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="10" Height="10"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>

                            <RadioButton Grid.Column="4" GroupName="LibraryViewMode"
                                         Style="{StaticResource SegmentedRadioButton}" Margin="0,0,8,0"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Grid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGridView}" Stretch="Uniform" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="GRID" Margin="8,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="5" GroupName="LibraryViewMode"
                                         Style="{StaticResource SegmentedRadioButton}" Margin="0,0,10,0"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=List}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconListView}" Stretch="Uniform" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6"/>
                                    <TextBlock Text="LIST" Margin="8,0,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <Button Grid.Column="6" Margin="0,0,10,0"
                                    Command="{Binding ToggleSelectionModeCommand}"
                                    ToolTip="Select multiple sounds">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectionModeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSelect}" Stretch="Uniform" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                    <TextBlock Text="SELECT" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="7" Style="{StaticResource AccentButton}"
                                    Command="{Binding ImportSoundsCommand}" ToolTip="Import sound files">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconImport}" Stretch="Uniform" Width="12" Height="12"
                                          Stroke="{DynamicResource BackgroundBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <TextBlock Text="IMPORT" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Bulk-action bar — only shown in Select mode. Actions are disabled (not
                             hidden) at zero selected so the bar's layout stays stable as the count
                             changes, same reasoning as other count-gated controls in this window. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="12,10"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsSelectionModeActive, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} SELECTED}" FontFamily="{DynamicResource MonoFontFamily}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <Button Content="SELECT ALL" Style="{StaticResource LinkButton}" Command="{Binding SelectAllVisibleCommand}" Margin="0,0,12,0"/>
                                <Button Content="CLEAR" Style="{StaticResource LinkButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,20,0"/>

                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding BulkDeleteSelectedCommand}"
                                        IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrash}" Stretch="Uniform" Width="11" Height="11" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        <TextBlock Text="DELETE" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BulkMoveToFolderButton" Style="{StaticResource ToolbarButton}"
                                        IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" Padding="8,4" Margin="0,0,8,0"
                                        Click="BulkMoveToFolderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="11" Height="11" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        <TextBlock Text="MOVE TO FOLDER" Margin="7,0,0,0"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Name="BulkMoveToFolderMenuRoot"/>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding BulkFavoriteSelectedCommand}"
                                        IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconStar}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="FAVORITE" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding BulkAddTagCommand}"
                                        IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTag}" Stretch="Uniform" Width="11" Height="11" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        <TextBlock Text="ADD TAG" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding BulkRemoveTagCommand}"
                                        IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTag}" Stretch="Uniform" Width="11" Height="11" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        <TextBlock Text="REMOVE TAG" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="{Binding IsGridVirtualized}">
                        <Grid>
                        <ItemsControl x:Name="SoundGridItemsControl" ItemsSource="{Binding VisibleSounds}"
                                  Visibility="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=Grid}"
                                  AllowDrop="True"
                                  DragOver="SoundGrid_DragOver"
                                  Drop="SoundGrid_Drop"
                                  ScrollViewer.CanContentScroll="{Binding IsGridVirtualized}"
                                  VirtualizingPanel.IsVirtualizing="{Binding IsGridVirtualized}"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Style>
                            <!-- VirtualizingWrapPanel has no non-virtualizing fallback mode (it
                                 throws unless IsVirtualizing="True" on this ItemsControl) — so
                                 the panel template itself has to swap with Performance Mode, in
                                 lockstep with the IsVirtualizing attached property above, rather
                                 than that property alone controlling behavior against one static
                                 panel. Off: today's exact plain WrapPanel, unchanged. On: the
                                 virtualizing one. ItemSize on the virtualizing panel is
                                 deliberately left at its default (auto-measures once from the
                                 first realized item) rather than bound to the ButtonSize slider —
                                 a known trade-off: resizing tiles via that slider while
                                 virtualizing may need a tab switch to refresh cleanly. -->
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsPanel" Value="{StaticResource PlainSoundGridPanel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridVirtualized}" Value="True">
                                        <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedSoundGridPanel}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundButtonViewModel}">
                                <Button Command="{Binding PlayCommand}"
                                        Width="{DynamicResource ButtonSize}"
                                        Height="{DynamicResource ButtonSize}"
                                        Margin="{DynamicResource ButtonSpacingThickness}"
                                        Opacity="{Binding IsPlaying, Converter={StaticResource PlayingOpacity}}"
                                        ContextMenuOpening="SoundButton_ContextMenuOpening"
                                        PreviewMouseLeftButtonDown="SoundButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="SoundButton_PreviewMouseMove"
                                        AllowDrop="True"
                                        DragEnter="SoundButton_DragEnter"
                                        DragLeave="SoundButton_DragLeave">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- Square patch-bay-slot card frame — same overall footprint as
                                                 before (fills the Button's ButtonSize x ButtonSize bounds
                                                 unchanged, so VirtualizingWrapPanel's ItemSize binding still
                                                 matches reality), with the circle inset inside it rather than
                                                 filling it. -->
                                            <Grid x:Name="Card"
                                                  Background="{DynamicResource SurfaceBrush}"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="Scale"/>
                                                </Grid.RenderTransform>
                                                <Border x:Name="CardBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

                                                <Border x:Name="Root"
                                                        Background="{Binding Sound.Color, Converter={StaticResource ColorToBrush}}"
                                                        Margin="16"
                                                        CornerRadius="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeToCornerRadius}}"
                                                        Clip="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeToEllipseClip}}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <!-- Glossy sheen overlay — a subtle top-down highlight over the flat
                                                             user-chosen color, for a bit of card depth without needing a
                                                             per-sound gradient computed anywhere. The circular Clip on Root
                                                             already confines this (and everything else below) to the circle,
                                                             so its own corners don't need to match. -->
                                                        <Border x:Name="Sheen">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                                                    <GradientStop Color="#14000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Grouped and vertically centered (rather than pinned to the
                                                             bottom edge, which is the narrowest part of a circle) so
                                                             everything stays within the circle's widest band. -->
                                                        <StackPanel VerticalAlignment="Center" Margin="18,0">
                                                            <TextBlock x:Name="NameText" Text="{Binding DisplayName}"
                                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Margin="0,0,0,4">
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="4" ShadowDepth="1"/>
                                                                </TextBlock.Effect>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding DurationText}"
                                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="10.5"
                                                                       Margin="0,0,0,6"/>

                                                            <Border Height="4" Background="#33000000">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStarGridLength}}"/>
                                                                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStarGridLength}, ConverterParameter=remainder}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="White"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Play-icon badge — signals "this is clickable" at a glance,
                                                             independent of the white ring (which signals CURRENTLY playing). -->
                                                        <Border x:Name="PlayBadge"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="8"
                                                                Width="22" Height="22"
                                                                CornerRadius="11"
                                                                Background="#77000000"
                                                                Opacity="0.55">
                                                            <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="9" Height="9" Fill="White" Margin="1,0,0,0"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Hotkey badge — now sits in the card's corner (outside the
                                                     circle) rather than overlapping its edge, sharp-cornered to
                                                     match the card frame. -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="6"
                                                        Padding="5,2"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding HotkeyDisplay, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>

                                                <!-- Route badge — only shown when this sound overrides the default
                                                     output route, same as the hotkey badge's null-hides-it pattern. -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="6"
                                                        Padding="5,2"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding RouteGlyph, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock Text="{Binding RouteGlyph}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>

                                                <!-- Selection checkbox — only shown in Select mode. -->
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Top"
                                                          Margin="0,6,0,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>

                                                <!-- Favorite toggle — a small corner hit-target (not a star icon;
                                                     the ring around the circle below is now the actual "favorited"
                                                     indicator), so favoriting still doesn't require the right-click
                                                     menu. Faint always-on outline, brightening on hover. -->
                                                <Button x:Name="FavoriteBadge"
                                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="6"
                                                        Width="18" Height="18"
                                                        Cursor="Hand"
                                                        Opacity="0.5"
                                                        ToolTip="Toggle favorite">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Opacity" Value="0.95"/>
                                                    <Setter TargetName="PlayBadge" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="FavoriteBadge" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <!-- Performance Mode (or Animations off) strips per-tile rendering cost that
                                                     multiplies with library size: the name's drop shadow, the gloss sheen
                                                     overlay, and the press-scale animation. Split into MultiDataTriggers
                                                     (rather than plain Triggers) since each needs to combine a UI routed
                                                     property — IsPressed via RelativeSource Self — with the data-bound
                                                     ReduceVisualEffects flag on the window's DataContext. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.ReduceVisualEffects, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.ReduceVisualEffects, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="NameText" Property="Effect" Value="{x:Null}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="White"/>
                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Play" Command="{Binding PlayCommand}"/>
                                            <MenuItem Header="Stop" Command="{Binding StopCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Settings" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.ShowSoundDetailsCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Rename" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.RenameSoundCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Toggle Favorite" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.ToggleFavoriteCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Move to Folder" Name="MoveToFolderMenuItem"/>
                                            <MenuItem Header="Set Hotkey..." Name="SetHotkeyMenuItem"/>
                                            <MenuItem Header="Output Route" Name="OutputRouteMenuItem"/>
                                            <MenuItem Header="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.DeleteSoundCommand}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- List view mode — same sound set, same PlayCommand/context menu/favorite
                         toggle as the grid tiles above, just laid out as rows. Drag-drop reorder
                         isn't wired here since custom ordering is a grid-only concept in this UI
                         (List is sorted by SortMode, not manually arranged). -->
                    <ItemsControl ItemsSource="{Binding VisibleSounds}"
                                  Visibility="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=List}"
                                  ScrollViewer.CanContentScroll="{Binding IsGridVirtualized}"
                                  VirtualizingPanel.IsVirtualizing="{Binding IsGridVirtualized}"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Style>
                            <!-- Same panel-swap-in-lockstep-with-IsVirtualizing reasoning as the
                                 grid view's Style above — kept symmetric rather than relying on
                                 the built-in VirtualizingStackPanel being more lenient than the
                                 third-party grid panel about a non-virtualizing state. -->
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsPanel" Value="{StaticResource PlainSoundListPanel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridVirtualized}" Value="True">
                                        <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedSoundListPanel}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundButtonViewModel}">
                                <Button Command="{Binding PlayCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        ContextMenuOpening="SoundButton_ContextMenuOpening">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" Padding="12,10"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Visibility="{Binding DataContext.IsSelectionModeActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>

                                                    <!-- Favorite indicator — a filled square when favorited, matching
                                                         the accent-ring language the Grid tiles use for the same state,
                                                         adapted to a flat row instead of a circle. -->
                                                    <Rectangle Grid.Column="1" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
                                                                <Setter Property="StrokeThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <Border Grid.Column="2" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center"
                                                            Background="{Binding Sound.Color, Converter={StaticResource ColorToBrush}}"/>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource MonoFontFamily}" Opacity="0.5" FontSize="10.5"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="4" Padding="5,2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Visibility="{Binding RouteGlyph, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock Text="{Binding RouteGlyph}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5"/>
                                                    </Border>

                                                    <Border Grid.Column="5" Padding="5,2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Visibility="{Binding HotkeyDisplay, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5"/>
                                                    </Border>

                                                    <Button Grid.Column="6"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Toggle favorite"
                                                            Style="{StaticResource ToolbarButton}" Padding="6,4" Margin="0,0,6,0">
                                                        <Path Data="{StaticResource IconStar}" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}"/>
                                                    </Button>

                                                    <Border Grid.Column="7" Width="26" Height="26" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource BackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Play" Command="{Binding PlayCommand}"/>
                                            <MenuItem Header="Stop" Command="{Binding StopCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Settings" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.ShowSoundDetailsCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Rename" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.RenameSoundCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Toggle Favorite" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.ToggleFavoriteCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Move to Folder" Name="MoveToFolderMenuItem"/>
                                            <MenuItem Header="Set Hotkey..." Name="SetHotkeyMenuItem"/>
                                            <MenuItem Header="Output Route" Name="OutputRouteMenuItem"/>
                                            <MenuItem Header="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.DeleteSoundCommand}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </Grid>
                        </ScrollViewer>
                    </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32"
                              Visibility="{Binding ShowVoiceChangerTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="VOICE CHANGER" FontFamily="{DynamicResource BrandFontFamily}" FontSize="22" Margin="0,0,0,4"/>
                        <TextBlock Text="Real-time effect on your mic passthrough voice. Needs mic passthrough enabled in Settings → Audio — there's nothing to process otherwise."
                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <!-- Empty state: no Voices created yet -->
                        <StackPanel Visibility="{Binding ShowCreateEmptyState, Converter={StaticResource BoolToVisibility}}"
                                    HorizontalAlignment="Center" Margin="0,48,0,0">
                            <Path Data="{StaticResource IconMic}" Stretch="Uniform" Width="34" Height="34" HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,16"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="No voices yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Create one to start changing your voice in real time." Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <Button Content="+ Create Voice" Style="{StaticResource AccentButton}" Command="{Binding StartCreateVoiceCommand}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Basic vs Advanced chooser, shown for both the first voice and every one after -->
                        <StackPanel Visibility="{Binding ShowVoiceModeChooser, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="What kind of voice?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="200" Height="150" Style="{StaticResource ToolbarButton}" Command="{Binding CreateBasicVoiceCommand}"
                                        Margin="0,0,12,0" Padding="14" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,8"
                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="BASIC VOICE" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Just pitch and tone — quick and simple." Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <Button Width="200" Height="150" Style="{StaticResource ToolbarButton}" Command="{Binding CreateAdvancedVoiceCommand}"
                                        Padding="14" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconMixer}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,8"
                                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="ADVANCED VOICE" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Full mixer — combine any number of effects." Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Command="{Binding CancelCreateVoiceCommand}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>

                        <!-- Voice list: every saved Voice, with Settings/Rename/Delete per card -->
                        <Grid Visibility="{Binding ShowVoiceList, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Your Voices" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Create New Voice" Style="{StaticResource AccentButton}" Command="{Binding StartCreateVoiceCommand}"/>
                            </Grid>
                            <!-- Voicemod-style icon grid — click a tile to turn it on (a white
                                 border marks whichever one is currently active; clicking it
                                 again, or clicking a different tile, turns it off). Right-click
                                 for Change Settings/Rename/Change Icon/Delete. -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VoiceChangerPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ActivateVoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="112" Height="112" Margin="0,0,14,14" Padding="0"
                                                Cursor="Hand" ToolTip="{Binding Name}"
                                                ContextMenuOpening="VoiceTileButton_ContextMenuOpening">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TileBorder" Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                                                        <StackPanel VerticalAlignment="Center" Margin="8">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="94"/>
                                                            <TextBlock Text="{Binding Mode}" Opacity="0.5" FontSize="9"
                                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Value="True">
                                                                    <Condition.Binding>
                                                                        <MultiBinding Converter="{StaticResource VoiceIsActive}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.ActiveVoiceId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                            <Binding Path="DataContext.VoiceChangerEnabled" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </Condition.Binding>
                                                                </Condition>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="White"/>
                                                            <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Change Settings"
                                                              Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.SelectVoiceCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Rename"
                                                              Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.RenameVoiceCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Change Icon"
                                                              Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.ChangeVoiceIconCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=Tag.DeleteVoiceCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="TEST" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                <Button Content="{Binding IsVoicePreviewActive, Converter={StaticResource TestMicLabel}}" Style="{StaticResource ToolbarButton}"
                                        Command="{Binding ToggleVoicePreviewCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <TextBlock Text="Plays your mic back through headphones with whichever voice is currently active, live. Use headphones, not speakers — monitoring your own mic through open speakers causes feedback/howl."
                                           Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Voice editor: one Voice's own settings, Basic or Advanced -->
                        <StackPanel Visibility="{Binding ShowVoiceEditor, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="← Back" Style="{StaticResource ToolbarButton}" Command="{Binding BackToVoiceListCommand}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedVoice.Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <CheckBox x:Name="VoiceChangerEnabledCheckBox" Content="Enable Voice Changer"
                                      IsChecked="{Binding VoiceChangerEnabled}" Margin="0,0,0,20"/>

                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=VoiceChangerEnabledCheckBox}">

                                <!-- Basic: just the two "identity" sliders, no checkboxes to fuss with -->
                                <StackPanel Visibility="{Binding SelectedVoice.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Basic}">
                                    <TextBlock Text="PITCH" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Deep" HorizontalAlignment="Left" Opacity="0.7"/>
                                        <TextBlock Text="Chipmunk" HorizontalAlignment="Right" Opacity="0.7"/>
                                    </Grid>
                                    <Slider Minimum="-12" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding VoiceChangerPitchSemitones}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding VoiceChangerPitchSemitones, Converter={StaticResource RangeToPercent}, ConverterParameter='-12,7'}"
                                               HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,24"/>

                                    <TextBlock Text="TONE" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Brightening the voice's timbre (not just raising pitch) is what actually reads as a different person rather than the same voice sped up."
                                               Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Darker" HorizontalAlignment="Left" Opacity="0.7"/>
                                        <TextBlock Text="Brighter" HorizontalAlignment="Right" Opacity="0.7"/>
                                    </Grid>
                                    <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding FormantShift}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding FormantShift, Converter={StaticResource RangeToPercent}, ConverterParameter='-12,12'}"
                                               HorizontalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Advanced: the full step mixer -->
                                <StackPanel Visibility="{Binding SelectedVoice.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Advanced}">

                                    <!-- Any number of the steps below can be enabled at once and combine into one
                                         processed voice, applied in a fixed order (waveshaping, then time-based
                                         effects, then distance shaping). Strength is the one global dial, blending
                                         the whole combined result against your dry voice. -->

                                    <TextBlock Text="STRENGTH" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Overall intensity of everything enabled below, blended against your unprocessed voice — turn this down to dial the whole mix back without re-tuning every step."
                                               Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Subtle" HorizontalAlignment="Left" Opacity="0.7"/>
                                        <TextBlock Text="Full" HorizontalAlignment="Right" Opacity="0.7"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding EffectStrength}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding EffectStrength, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                               HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,24"/>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="PITCH" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding PitchEnabled}"/>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Deep" HorizontalAlignment="Left" Opacity="0.7"/>
                                            <TextBlock Text="Chipmunk" HorizontalAlignment="Right" Opacity="0.7"/>
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding VoiceChangerPitchSemitones}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding VoiceChangerPitchSemitones, Converter={StaticResource RangeToPercent}, ConverterParameter='-12,7'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="FORMANT SHIFT" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding FormantEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Brightening the voice's timbre (not just raising pitch) is what actually reads as a different person rather than the same voice sped up. Rides Pitch's own formant correction when Pitch is also enabled, for better quality."
                                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Darker" HorizontalAlignment="Left" Opacity="0.7"/>
                                            <TextBlock Text="Brighter" HorizontalAlignment="Right" Opacity="0.7"/>
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding FormantShift}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding FormantShift, Converter={StaticResource RangeToPercent}, ConverterParameter='-12,12'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="TEMPO" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding TempoEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Speaking faster or slower without changing your pitch — independent of the Pitch step above, on or off."
                                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Slower" HorizontalAlignment="Left" Opacity="0.7"/>
                                            <TextBlock Text="Faster" HorizontalAlignment="Right" Opacity="0.7"/>
                                        </Grid>
                                        <Slider Minimum="75" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding VoiceChangerTempoPercent}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding VoiceChangerTempoPercent, StringFormat={}{0:0}%}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="ROBOT" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding RobotEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Buzz frequency" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding RobotFrequencyHz}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding RobotFrequencyHz, Converter={StaticResource RangeToPercent}, ConverterParameter='10,100'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Waveform" Opacity="0.7" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,4">
                                            <RadioButton Content="Sine" GroupName="RobotWaveform" Style="{StaticResource SegmentedRadioButton}"
                                                         IsChecked="{Binding RobotWaveform, Converter={StaticResource EnumToBool}, ConverterParameter=Sine}"/>
                                            <RadioButton Content="Square" GroupName="RobotWaveform" Style="{StaticResource SegmentedRadioButton}"
                                                         IsChecked="{Binding RobotWaveform, Converter={StaticResource EnumToBool}, ConverterParameter=Square}"/>
                                            <RadioButton Content="Triangle" GroupName="RobotWaveform" Style="{StaticResource SegmentedRadioButton}"
                                                         IsChecked="{Binding RobotWaveform, Converter={StaticResource EnumToBool}, ConverterParameter=Triangle}"/>
                                        </WrapPanel>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding RobotMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding RobotMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="DISTORTION" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding DistortionEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Smooth, symmetric saturation." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drive" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding DistortionDrive}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DistortionDrive, Converter={StaticResource RangeToPercent}, ConverterParameter='1,20'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding DistortionMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DistortionMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="OVERDRIVE" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding OverdriveEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="A harder, edgier clip than Distortion — a genuinely different curve, not just a renamed knob." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drive" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding OverdriveDrive}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding OverdriveDrive, Converter={StaticResource RangeToPercent}, ConverterParameter='1,15'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding OverdriveMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding OverdriveMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="DELAY" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding DelayEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="One clean repeat — no trailing decay, unlike Echo below." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Delay" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="20" Maximum="500" TickFrequency="20" IsSnapToTickEnabled="True"
                                                Value="{Binding DelayMs}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DelayMs, Converter={StaticResource RangeToPercent}, ConverterParameter='20,500'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding DelayMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DelayMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="ECHO" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding EchoEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Delay" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="50" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                                                Value="{Binding EchoDelayMs}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding EchoDelayMs, Converter={StaticResource RangeToPercent}, ConverterParameter='50,1000'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Feedback" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding EchoFeedback}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding EchoFeedback, Converter={StaticResource RangeToPercent}, ConverterParameter='0,0.9'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding EchoMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding EchoMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="REVERB" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding ReverbEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Room Size" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0.1" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding ReverbRoomSize}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ReverbRoomSize, Converter={StaticResource RangeToPercent}, ConverterParameter='0.1,2.0'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Decay" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding ReverbDecay}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ReverbDecay, Converter={StaticResource RangeToPercent}, ConverterParameter='0,0.9'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding ReverbMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ReverbMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                    <CheckBox Content="PROXIMITY" FontWeight="Bold" FontSize="11"
                                              Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                              IsChecked="{Binding ProximityEnabled}"/>
                                    <StackPanel>
                                        <TextBlock Text="Simulated distance from the mic — quieter and duller as it increases." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Close" HorizontalAlignment="Left" Opacity="0.7"/>
                                            <TextBlock Text="Far" HorizontalAlignment="Right" Opacity="0.7"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding ProximityDistance}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding ProximityDistance, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,12"/>

                                        <TextBlock Text="Mix (dry/wet)" Opacity="0.7" Margin="0,0,0,4"/>
                                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding ProximityMix}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ProximityMix, Converter={StaticResource RangeToPercent}, ConverterParameter='0,1'}"
                                                   HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="TEST" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                                <Button Content="{Binding IsVoicePreviewActive, Converter={StaticResource TestMicLabel}}" Style="{StaticResource ToolbarButton}"
                                        Command="{Binding ToggleVoicePreviewCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <TextBlock Text="Plays your mic back through headphones with the current effect applied, live. Use headphones, not speakers — monitoring your own mic through open speakers causes feedback/howl."
                                           Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32"
                              Visibility="{Binding ShowPluginsPanelTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="🧩 Plugins" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Buttons registered by your installed Community Plugins." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <ItemsControl ItemsSource="{Binding PluginPanelGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PluginPanelGroupViewModel}">
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="{Binding PluginName}" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Buttons}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PluginPanelButtonViewModel}">
                                                    <Button Content="{Binding Label}" Command="{Binding InvokeCommand}"
                                                            Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Sound Details panel — right-side, shown for whichever sound was last
                 double-clicked or opened via its context menu, until explicitly closed. -->
            <Border Grid.Column="3" Width="320" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowDetailsPanel, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel DataContext="{Binding SelectedDetailsSound}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource ToolbarButton}" ToolTip="Close"
                                    Command="{Binding DataContext.CloseSoundDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="6,4" Margin="8,0,0,0" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Waveform -->
                        <Border Height="60" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Loading waveform..." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" FontSize="11"
                                           Visibility="{Binding DataContext.IsLoadingWaveform, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding DataContext.DetailsWaveformPeaks, RelativeSource={RelativeSource AncestorType=Window}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="2" Margin="1,0" VerticalAlignment="Center" CornerRadius="1"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Height="{Binding Converter={StaticResource PeakToBarHeight}, ConverterParameter=52}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Play / Stop -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="▶ Play" Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Padding="14,8"/>
                            <Button Content="■ Stop" Command="{Binding StopCommand}" Style="{StaticResource ToolbarButton}" Padding="14,8"/>
                        </StackPanel>

                        <TextBlock Text="FORMAT" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding FormatText}" Margin="0,0,0,14"/>

                        <TextBlock Text="DURATION" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DurationText}" Margin="0,0,0,14"/>

                        <TextBlock Text="NAME" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Rename..." Style="{StaticResource ToolbarButton}"
                                    Command="{Binding DataContext.RenameSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Padding="8,4"/>
                        </Grid>

                        <TextBlock Text="FOLDER" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DetailsFolderCombo" Margin="0,0,0,14"
                                  ItemsSource="{Binding DataContext.DetailsFolderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Sound.FolderId, Mode=OneWay}"
                                  SelectionChanged="DetailsFolder_SelectionChanged"/>

                        <TextBlock Text="TAGS (comma-separated)" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DetailsTagsBox" Text="{Binding TagsText, Mode=OneWay}" Margin="0,0,0,14" LostFocus="DetailsTags_LostFocus"/>

                        <TextBlock Text="HOTKEY" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding HotkeyDisplay, TargetNullValue=None}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Set..." Style="{StaticResource ToolbarButton}" Padding="8,4" Click="DetailsSetHotkey_Click"/>
                        </Grid>

                        <TextBlock Text="VOLUME" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Slider x:Name="DetailsVolumeSlider" Minimum="0" Maximum="2" Value="{Binding Sound.Volume, Mode=OneWay}" Margin="0,0,0,14"
                                PreviewMouseUp="DetailsVolumeSlider_PreviewMouseUp"/>

                        <TextBlock Text="PLAYBACK MODE" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DetailsPlaybackModeCombo" Margin="0,0,0,14"
                                  ItemsSource="{Binding DataContext.PlaybackModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValue="{Binding Sound.PlaybackMode, Mode=OneWay}"
                                  SelectionChanged="DetailsPlaybackMode_SelectionChanged"/>

                        <TextBlock Text="OUTPUT ROUTE" FontWeight="Bold" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DetailsRouteCombo" Margin="0,0,0,4"
                                  ItemsSource="{Binding DataContext.DetailsRouteOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Route"
                                  SelectedValue="{Binding Sound.OutputRouteOverride, Mode=OneWay}"
                                  SelectionChanged="DetailsRoute_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Global Playback Bar: the focused sound gets full transport controls (seek, ±10s,
             restart); any other sounds playing at the same time show as compact pills above it,
             each with its own pause/stop and a click to bring it into focus. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12"
                Visibility="{Binding HasNowPlaying, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding OtherActivePlaybackItems}" Margin="0,0,0,10"
                              Visibility="{Binding HasOtherActivePlayback, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActivePlaybackItemViewModel}">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding SoundName}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Padding="0" Margin="0,0,10,0"
                                            Command="{Binding DataContext.PromoteToNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Bring this into the main transport controls">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button ToolTip="Pause/Resume"
                                            Command="{Binding TogglePauseCommand}" Style="{StaticResource ToolbarButton}" Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                                        <Grid>
                                            <Path Data="{StaticResource IconPause}" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}"
                                                  Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}"
                                                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                    <Button ToolTip="Stop" Command="{Binding StopCommand}" Style="{StaticResource ToolbarButton}" Width="28" Height="28" Padding="0">
                                        <Path Data="{StaticResource IconStop}" Stretch="Uniform" Width="8" Height="8" Fill="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding NowPlayingName}" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ProgressBar x:Name="NowPlayingProgressBar" Grid.Row="0" Minimum="0" Maximum="{Binding NowPlayingDuration}" Value="{Binding NowPlayingPosition, Mode=OneWay}" Height="6"
                                     Cursor="Hand" MouseLeftButtonDown="NowPlayingProgressBar_MouseLeftButtonDown"/>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <TextBlock Text="{Binding NowPlayingPosition, Converter={StaticResource SecondsToTime}}" FontFamily="{DynamicResource MonoFontFamily}"
                                       HorizontalAlignment="Left" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NowPlayingDuration, Converter={StaticResource SecondsToTime}}" FontFamily="{DynamicResource MonoFontFamily}"
                                       HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="Back 10s" Style="{StaticResource ToolbarButton}" Command="{Binding NowPlayingSeekBackCommand}" Width="36">
                            <Path Data="{StaticResource IconSeekBack}" Stretch="Uniform" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        </Button>
                        <Button ToolTip="Pause/Resume" Style="{StaticResource ToolbarButton}" Command="{Binding NowPlayingTogglePauseCommand}" Width="36">
                            <Grid>
                                <Path Data="{StaticResource IconPause}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource TextPrimaryBrush}"
                                      Visibility="{Binding NowPlayingIsPaused, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <Path Data="{StaticResource IconPlay}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource TextPrimaryBrush}"
                                      Visibility="{Binding NowPlayingIsPaused, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Button>
                        <Button ToolTip="Forward 10s" Style="{StaticResource ToolbarButton}" Command="{Binding NowPlayingSeekForwardCommand}" Width="36">
                            <Path Data="{StaticResource IconSeekForward}" Stretch="Uniform" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        </Button>
                        <Button ToolTip="Restart" Style="{StaticResource ToolbarButton}" Command="{Binding NowPlayingRestartCommand}" Width="36">
                            <Path Data="{StaticResource IconRestart}" Stretch="Uniform" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button ToolTip="Stop" Style="{StaticResource ToolbarButton}" Command="{Binding NowPlayingStopCommand}" Width="36" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconStop}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button ToolTip="Stop every sound currently playing" Command="{Binding StopAllCommand}" Width="Auto" Padding="12,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStop}" Stretch="Uniform" Width="10" Height="10" Fill="White" Margin="0,0,7,0"/>
                                <TextBlock Text="STOP ALL"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ImportProgressText}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
