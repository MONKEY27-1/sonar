<Window x:Class="Soundboard.Views.ScriptPluginAuthoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit a Plugin"
        Width="560"
        Height="700"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="28" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="Submit a Plugin" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="A small script, run in a sandbox — it can only list/play your sounds and log text, nothing else. Published plugins start unverified until an admin reviews them." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="Name" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Description (optional)" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,16"/>

            <TextBlock Text="Script" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ScriptSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                     FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Height="180" Margin="0,0,0,12"/>

            <Button Content="▶ Test Run" Style="{StaticResource ToolbarButton}" Command="{Binding TestRunCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,8"/>

            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,20"
                    Visibility="{Binding TestRunOutput, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding TestRunOutput}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,12"/>

            <Button Content="Publish" Style="{StaticResource AccentButton}" Command="{Binding PublishCommand}"
                    HorizontalAlignment="Left" Width="140"/>
        </StackPanel>
    </ScrollViewer>
</Window>
