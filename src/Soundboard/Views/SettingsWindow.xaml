<Window x:Class="Soundboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Soundboard.Views.Controls"
        xmlns:local="clr-namespace:Soundboard.Core.Models;assembly=Soundboard"
        Title="Settings"
        Width="880"
        Height="700"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="24" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category nav -->
            <StackPanel Grid.Column="0" Margin="0,4,16,0">
                <Button Content="Audio" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Audio}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Audio">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Playback" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Playback}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Playback">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Hotkeys" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Hotkeys}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Hotkeys">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Appearance" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Appearance}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Appearance">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Library" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Library}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Library">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Notifications" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Notifications}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Notifications">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Performance" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Performance}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4"
                        Visibility="{Binding IsPerformanceModeInstalled, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Performance">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Diagnostics" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Diagnostics}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4"
                        Visibility="{Binding IsAdvancedSettingsInstalled, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Diagnostics">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>

                <Button Content="Account" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Account}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Account">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Security" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Security}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Security">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="License" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.License}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="License">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Installation" Command="{Binding SelectCategoryCommand}" CommandParameter="{x:Static local:SettingsCategory.Installation}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Installation">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Category content -->
            <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Audio}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Global volume:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Width="200" Value="{Binding Settings.Audio.GlobalVolume}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Headphone volume:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Width="200" Value="{Binding Settings.Audio.HeadphoneVolume}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Virtual mic output volume:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Width="200" Value="{Binding Settings.Audio.VirtualMicOutputVolume}"/>
                        </StackPanel>
                        <CheckBox Content="Master mute" IsChecked="{Binding Settings.Audio.MasterMuted}" Margin="0,0,0,8"/>
                        <StackPanel Visibility="{Binding IsAdvancedSettingsInstalled, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                            <CheckBox Content="Normalize audio globally" IsChecked="{Binding Settings.Audio.NormalizeGlobally}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Normalize All Sounds" Style="{StaticResource ToolbarButton}" Command="{Binding NormalizeAllSoundsCommand}"
                                        ToolTip="Analyzes every already-imported sound's loudness and caches a gain for it — new imports do this automatically."/>
                                <TextBlock Text="{Binding NormalizeStatus}" VerticalAlignment="Center" Opacity="0.75" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <controls:MultiDeviceSelector Label="Headphones / Speakers (plays through all checked at once)"
                                                       ItemsSource="{Binding HeadphoneDeviceOptions}"/>

                        <controls:DeviceSelector Label="Virtual mic output (optional — e.g. VB-Cable Input, for streaming/Discord)"
                                                  ItemsSource="{Binding OutputDevices}"
                                                  SelectedValue="{Binding Settings.Audio.VirtualMicOutputDeviceId}"/>

                        <ItemsControl ItemsSource="{Binding DetectedVirtualDevices}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="440">
                                                <TextBlock Text="{Binding Product}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PlaybackDeviceName}" Opacity="0.8" TextWrapping="Wrap"/>
                                                <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                                           Visibility="{Binding RecordingDeviceName, Converter={StaticResource NullToCollapsed}}">
                                                    <Run Text="Tip: set Discord/your game's mic input to "/>
                                                    <Run Text="{Binding RecordingDeviceName, Mode=OneWay}" FontStyle="Italic"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Content="Use for virtual mic output"
                                                    Style="{StaticResource ToolbarButton}"
                                                    Command="{Binding DataContext.UseDetectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Default output routing" Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding OutputRoutes}"
                                  SelectedItem="{Binding Settings.Audio.DefaultOutputRoute}"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Microphone" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <controls:MultiDeviceSelector Label="Your microphone(s) (captured and mixed together)"
                                                       ItemsSource="{Binding MicrophoneDeviceOptions}"/>
                        <TextBlock Text="Your voice is automatically mixed into the virtual mic output alongside sound effects whenever one is configured above."
                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Voice volume:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Width="200" Value="{Binding Settings.Audio.MicPassthroughVolume}"/>
                        </StackPanel>

                        <TextBlock Text="Voice Changer has moved — click 🎙 Voice Changer in the main window's sidebar, next to Favorites and Recently Used." Opacity="0.6" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Playback}">
                    <StackPanel>
                        <TextBlock Text="Queue mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="What happens when a sound is triggered while another is already playing." Opacity="0.7" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding QueueModes}"
                                  SelectedItem="{Binding Settings.Playback.QueueMode}"
                                  Width="200"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Appearance}">
                    <StackPanel>
                        <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox Content="Start minimized" IsChecked="{Binding Settings.General.StartMinimized}" Margin="0,0,0,4"/>
                        <CheckBox Content="Minimize to tray" IsChecked="{Binding Settings.General.MinimizeToTray}" Margin="0,0,0,4"/>
                        <CheckBox Content="Launch on Windows startup" IsChecked="{Binding Settings.General.LaunchOnStartup}" Margin="0,0,0,16"/>

                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ThemeKinds}"
                                  SelectedItem="{Binding Settings.Theme.Kind}"
                                  Margin="0,0,0,16"
                                  Width="200"
                                  HorizontalAlignment="Left"/>

                        <TextBlock Text="Accent color" Margin="0,0,0,4"/>
                        <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Settings.Theme.AccentColor}" Margin="0,0,0,4"
                                 IsEnabled="{Binding IsProUnlocked}"
                                 ToolTip="Custom accent color is a Pro feature"/>
                        <TextBlock Text="Custom accent color is a Pro feature" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,8"
                                   Visibility="{Binding IsProUnlocked, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <TextBlock Text="Custom colors (only used when Theme is set to Custom)" Opacity="0.7" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Background:" Width="140" VerticalAlignment="Center"/>
                            <TextBox Width="120" Text="{Binding Settings.Theme.BackgroundColor}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Surface:" Width="140" VerticalAlignment="Center"/>
                            <TextBox Width="120" Text="{Binding Settings.Theme.SurfaceColor}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Text:" Width="140" VerticalAlignment="Center"/>
                            <TextBox Width="120" Text="{Binding Settings.Theme.TextColor}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Button size:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="72" Maximum="200" Width="200" Value="{Binding Settings.Theme.ButtonSize}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Button spacing:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="32" Width="200" Value="{Binding Settings.Theme.ButtonSpacing}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Corner radius:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="24" Width="200" Value="{Binding Settings.Theme.CornerRadius}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Window opacity:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0.3" Maximum="1" Width="200" Value="{Binding Settings.Theme.WindowOpacity}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Font family:" Width="140" VerticalAlignment="Center"/>
                            <TextBox Width="200" Text="{Binding Settings.Theme.FontFamily}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Font size:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="10" Maximum="20" Width="200" Value="{Binding Settings.Theme.FontSize}"/>
                        </StackPanel>

                        <CheckBox Content="Enable interface animations (hover/press effects, transitions)"
                                  IsChecked="{Binding Settings.Theme.AnimationsEnabled}"/>
                    </StackPanel>
                </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Library}">
                    <StackPanel>
                        <TextBlock Text="Sound defaults" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Applied to newly imported sounds — existing sounds are unaffected" Opacity="0.7" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Default volume:" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Width="200" Value="{Binding Settings.SoundDefaults.Volume}"/>
                        </StackPanel>
                        <CheckBox Content="Normalize" IsChecked="{Binding Settings.SoundDefaults.Normalize}" Margin="0,0,0,16"/>

                        <CheckBox Content="Fade in" IsChecked="{Binding Settings.SoundDefaults.FadeIn}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Fade in duration (ms):" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="2000" Width="200" Value="{Binding Settings.SoundDefaults.FadeInMs}"/>
                        </StackPanel>

                        <CheckBox Content="Fade out" IsChecked="{Binding Settings.SoundDefaults.FadeOut}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Fade out duration (ms):" Width="140" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="2000" Width="200" Value="{Binding Settings.SoundDefaults.FadeOutMs}"/>
                        </StackPanel>

                        <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Saves your sounds, folders, and settings to a single file you can restore from later." Opacity="0.7" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Export Collection" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCollectionCommand}"/>
                            <Button Content="Import Collection" Style="{StaticResource ToolbarButton}" Command="{Binding ImportCollectionCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Hotkeys}">
                    <StackPanel>
                        <TextBlock Text="Global hotkeys work anywhere, even when Soundboard isn't focused" Opacity="0.7" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stop all sounds:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonStopAll" Tag="StopAll" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="StopAll" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pause all sounds:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonPauseAll" Tag="PauseAll" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="PauseAll" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resume all sounds:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonResumeAll" Tag="ResumeAll" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="ResumeAll" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Toggle loop:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonToggleLoop" Tag="ToggleLoop" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="ToggleLoop" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Toggle voice changer:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonToggleVoiceChanger" Tag="ToggleVoiceChanger" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="ToggleVoiceChanger" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Quick-play overlay:" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HotkeyButtonToggleQuickPlayOverlay" Tag="ToggleQuickPlayOverlay" Content="Click to set"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_PreviewKeyDown" HorizontalAlignment="Left" Width="170"/>
                            <Button Grid.Column="2" Tag="ToggleQuickPlayOverlay" Content="Clear" Style="{StaticResource ToolbarButton}" Click="HotkeyClear_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Notifications}">
                    <StackPanel>
                        <TextBlock Text="Which events should show a notification." FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="These currently show as a brief status-bar message rather than a popup." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <CheckBox Content="Import complete / limited" IsChecked="{Binding Settings.Notifications.OnImport}" Margin="0,0,0,10"/>
                        <CheckBox Content="Errors (playback failures, license limits)" IsChecked="{Binding Settings.Notifications.OnError}" Margin="0,0,0,10"/>
                        <CheckBox Content="A sound starts playing" IsChecked="{Binding Settings.Notifications.OnPlaybackStarted}" Margin="0,0,0,10"/>
                        <CheckBox Content="A sound finishes playing" IsChecked="{Binding Settings.Notifications.OnPlaybackFinished}"/>
                    </StackPanel>
                </ScrollViewer>
            <Border Visibility="{Binding IsPerformanceModeInstalled, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                              Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Performance}">
                    <StackPanel>
                        <TextBlock Text="Each of these defaults to on when Performance Mode is installed — turn off whichever you don't want individually." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <TextBlock Text="Audio latency" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding LatencyModes}"
                                  SelectedItem="{Binding Settings.Audio.LatencyMode}"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,20"/>

                        <TextBlock Text="Sound library" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox Content="Reduce visual effects on sound tiles (shadows, gloss, press animation)"
                                  IsChecked="{Binding Settings.Performance.ReduceVisualEffects}" Margin="0,0,0,10"/>
                        <CheckBox Content="Virtualize the sound grid/list for large libraries"
                                  IsChecked="{Binding Settings.Performance.VirtualizeLibrary}" Margin="0,0,0,20"/>

                        <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox Content="Check for account updates less often (every 15 minutes instead of 5)"
                                  IsChecked="{Binding Settings.Performance.ReduceBackgroundPolling}" Margin="0,0,0,8"/>
                        <TextBlock Text="Slower to notice a remote account suspension or a license change made elsewhere (e.g. the website) — takes effect on next login, not live mid-session." Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Visibility="{Binding IsAdvancedSettingsInstalled, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                              Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Diagnostics}">
                    <StackPanel>
                        <TextBlock Text="Audio test" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Plays a short chime through the selected route so you can confirm it's actually reaching the right place." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Test Headphones" Style="{StaticResource ToolbarButton}" Command="{Binding TestHeadphonesCommand}"/>
                            <Button Content="Test Virtual Mic Output" Style="{StaticResource ToolbarButton}" Command="{Binding TestVirtualMicCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DiagnosticsStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <TextBlock Text="Current configuration" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Headphones:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HeadphoneDeviceSummary}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Virtual mic output:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VirtualMicDeviceSummary}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Microphone:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MicrophoneDeviceSummary}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Default routing:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Audio.DefaultOutputRoute}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Latency mode:" Opacity="0.7"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Audio.LatencyMode}"/>
                        </Grid>

                        <TextBlock Text="Troubleshooting" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Content="Open Logs Folder" Style="{StaticResource ToolbarButton}" Command="{Binding OpenLogsFolderCommand}"/>
                            <Button Content="Open Settings Folder" Style="{StaticResource ToolbarButton}" Command="{Binding OpenSettingsFolderCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Danger zone" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Resets theme, audio devices, hotkeys, playback preferences, and notifications back to defaults. Your sound library and account are not affected." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Reset to Defaults" Style="{StaticResource ToolbarButton}" Command="{Binding ResetToDefaultsCommand}" Background="#DC2626" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Account}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="You're not logged in — Soundboard works fully offline in the free tier." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Use the account button in the toolbar to log in or create an account." Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Signed in as" Opacity="0.7" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding AccountEmail}" FontWeight="SemiBold" Margin="0,0,0,20"/>

                            <TextBlock Text="Sign-in" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Remember me" IsChecked="{Binding Settings.Account.RememberMe}" Margin="0,0,0,8"/>
                            <CheckBox Content="Automatically sign in at startup" IsChecked="{Binding Settings.Account.AutoLoginEnabled}" Margin="0,0,0,20"/>

                            <TextBlock Text="Cloud" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Enable Cloud Sync" IsChecked="{Binding CloudEnabled}"
                                      IsEnabled="{Binding CanUseCloudSync}"
                                      ToolTip="Syncs settings and sound library metadata (names, tags, favorites, folders) across devices — not the audio files themselves." Margin="0,0,0,4"/>
                            <TextBlock Text="Cloud Sync is a Pro feature" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,20"
                                       Visibility="{Binding CanUseCloudSync, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <TextBlock Text="{Binding AccountStatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button Content="Log Out" Style="{StaticResource ToolbarButton}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Security}">
                    <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Email verification" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="✓ Verified" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,20"
                                   Visibility="{Binding IsEmailVerified, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding IsEmailVerified, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,0,0,20">
                            <TextBlock Text="⚠ Not verified" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                            <Button Content="Resend Verification Email" Style="{StaticResource ToolbarButton}" Command="{Binding ResendVerificationCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Text="This device" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding LastLoginText, StringFormat='Last login: {0}'}" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SessionExpiryText, StringFormat='Session valid until: {0}'}" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="Listing other signed-in devices requires a server-side admin API not yet built — logging out here only signs out this device." Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <TextBlock Text="Change Password" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Current password" Opacity="0.7" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ChangePasswordCurrentBox" PasswordChanged="ChangePasswordCurrentBox_PasswordChanged"
                                     Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,8" MaxWidth="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="New password" Opacity="0.7" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ChangePasswordNewBox" PasswordChanged="ChangePasswordNewBox_PasswordChanged"
                                     Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,8" MaxWidth="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Confirm new password" Opacity="0.7" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ChangePasswordConfirmBox" PasswordChanged="ChangePasswordConfirmBox_PasswordChanged"
                                     Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,8" MaxWidth="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ChangePasswordMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Change Password" Style="{StaticResource ToolbarButton}" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Margin="0,0,0,28"/>

                        <TextBlock Text="Danger Zone" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Flags your account for deletion and logs you out immediately. Actual removal happens server-side and cannot be undone from within the app." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Delete Account" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteAccountCommand}" Background="#DC2626" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=License}">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,20"
                                Visibility="{Binding IsBetaTester, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="⭐ Early Supporter" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Lifetime Pro License — every feature unlocked, forever. Thank you for testing early." Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Current license" Opacity="0.7" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentLicense}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,24"/>

                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <!-- Free -->
                            <Border Margin="0,0,10,0" CornerRadius="12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFreeTierCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="FREE" FontWeight="Bold" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="$0" FontWeight="Bold" FontSize="26" Margin="0,4,0,14"/>
                                    <TextBlock Text="✓ Full soundboard" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ 15 sounds, 1 folder" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Global hotkeys &amp; mic routing" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Community plugins &amp; packs" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                    <Border Padding="8,6" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsFreeTierCurrent, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Your Plan" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Beta Tester -->
                            <Border Margin="0,0,10,0" CornerRadius="12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBetaTester}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="BETA TESTER" FontWeight="Bold" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="$0" FontWeight="Bold" FontSize="26"/>
                                    </StackPanel>
                                    <TextBlock Text="lifetime Pro" Opacity="0.6" FontSize="11" Margin="0,0,0,12"/>
                                    <TextBlock Text="✓ Everything in Free" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Unlimited sounds &amp; folders" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Voice Changer, custom themes" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Cloud Sync, early access" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                    <Border Padding="8,6" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsBetaTester, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Your Plan" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Button Content="Ask About Beta Access" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left"
                                            Command="{Binding OpenSupportCommand}"
                                            Visibility="{Binding IsBetaTester, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Pro -->
                            <Border CornerRadius="12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProTierCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="PRO" FontWeight="Bold" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- Keep in sync with the Price created in the Stripe dashboard (STRIPE_PRICE_ID). -->
                                    <TextBlock Text="$9.99 one-time" FontWeight="Bold" FontSize="18" Margin="0,4,0,14"/>
                                    <TextBlock Text="✓ Everything in Beta Tester" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Priority support" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="✓ Cloud Sync for settings &amp; library" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                    <Border Padding="8,6" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsProTierCurrent, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Your Plan" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <!-- Hidden whenever Pro is unlocked by ANY path (a real purchase, Beta Tester, or an
                                         admin/developer grant) — not just IsProTierCurrent, so a Beta Tester (who already
                                         has full Pro access for free) doesn't see an active "buy Pro" button. The "Your
                                         Plan" badge above stays on IsProTierCurrent since that's about which single card
                                         is highlighted as current, not about whether purchasing still makes sense. -->
                                    <Button Content="Upgrade to Pro" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left"
                                            Command="{Binding UpgradeToProCommand}"
                                            Visibility="{Binding IsProUnlocked, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0"
                          Visibility="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Installation}">
                    <StackPanel>
                        <TextBlock Text="App info" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersionText}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Installed at:" Opacity="0.7" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallLocationText}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Your data:" Opacity="0.7"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataLocationText}" TextWrapping="Wrap"/>
                        </Grid>

                        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox Content="Check for updates on launch" IsChecked="{Binding Settings.General.CheckForUpdatesOnLaunch}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Content="Check for Updates" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBoolean}}"/>
                            <TextBlock Text="{Binding UpdateCheckStatusText}" VerticalAlignment="Center" Opacity="0.75" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Worth doing before uninstalling everything below — this saves your sounds, folders, and settings to a single file you can restore from later." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Export Collection" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCollectionCommand}" HorizontalAlignment="Left" Margin="0,0,0,24"/>

                        <TextBlock Text="Uninstall" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="Removes the app itself. Your settings, sound library, and imported files are kept — reinstalling later picks up right where you left off." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Uninstall" Style="{StaticResource ToolbarButton}" Command="{Binding UninstallAppCommand}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                        <TextBlock Text="Removes the app AND permanently deletes your settings, sounds, and folders. This cannot be undone." Foreground="#F87171" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Uninstall Everything" Style="{StaticResource ToolbarButton}" Command="{Binding UninstallEverythingCommand}" Background="#DC2626" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Refresh Devices" Style="{StaticResource ToolbarButton}" Command="{Binding LoadDevicesCommand}"/>
            <Button Content="Save" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
