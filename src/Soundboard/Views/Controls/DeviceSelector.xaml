<UserControl x:Class="Soundboard.Views.Controls.DeviceSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soundboard.Views.Controls"
             x:Name="Root">
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Opacity="0.7" Margin="0,0,0,4"
                    Visibility="{Binding Label, ElementName=Root, Converter={StaticResource NullToCollapsed}}"/>
        <ComboBox ItemsSource="{Binding ItemsSource, ElementName=Root}"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedValue, ElementName=Root, Mode=TwoWay}"
                  Margin="0,0,0,8">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text=" — Default" Opacity="0.55" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>
