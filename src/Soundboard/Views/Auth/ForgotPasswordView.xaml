<UserControl x:Class="Soundboard.Views.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Reset Password" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Step A: enter email -->
            <StackPanel Visibility="{Binding ShowForgotConfirm, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Enter your account email and we'll send you a reset code." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="Email" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ForgotEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,16"/>

                <Button Content="Send Reset Code" Style="{StaticResource AccentButton}" Command="{Binding RequestPasswordResetCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
            </StackPanel>

            <!-- Step B: enter code + new password -->
            <StackPanel Visibility="{Binding ShowForgotConfirm, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ForgotEmail, StringFormat='Enter the code we sent to {0} and choose a new password.'}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="Reset code" Opacity="0.7" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ForgotCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

                <TextBlock Text="New password" Opacity="0.7" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ForgotNewPasswordBox" PasswordChanged="ForgotNewPasswordBox_PasswordChanged"
                             Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding ForgotPasswordStrength.Label}" Opacity="0.6" FontSize="11" Margin="0,0,0,8"/>

                <TextBlock Text="Confirm new password" Opacity="0.7" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ForgotConfirmPasswordBox" PasswordChanged="ForgotConfirmPasswordBox_PasswordChanged"
                             Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,16"/>

                <Button Content="Reset Password" Style="{StaticResource AccentButton}" Command="{Binding ConfirmPasswordResetCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding InfoMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,16,0,0"/>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="&#8592; Back to Log In" Style="{StaticResource LinkButton}" Command="{Binding GoToLoginCommand}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
