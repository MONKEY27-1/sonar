<Window x:Class="Soundboard.Views.Auth.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soundboard.Views.Auth"
        Title="Sonar Account"
        Width="440"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <views:WelcomeView Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}"/>
        <views:LoginView Visibility="{Binding ShowLogin, Converter={StaticResource BoolToVisibility}}"/>
        <views:RegisterView Visibility="{Binding ShowRegister, Converter={StaticResource BoolToVisibility}}"/>
        <views:ForgotPasswordView Visibility="{Binding ShowForgotPassword, Converter={StaticResource BoolToVisibility}}"/>
        <views:EmailVerificationView Visibility="{Binding ShowEmailVerification, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</Window>
