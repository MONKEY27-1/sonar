<UserControl x:Class="Soundboard.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Log In" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

            <TextBlock Text="Email or username" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding LoginEmailOrUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,16"/>

            <TextBlock Text="Password" Opacity="0.7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="LoginPasswordBox" PasswordChanged="LoginPasswordBox_PasswordChanged"
                         Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,16">
                <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}" HorizontalAlignment="Left"/>
                <Button Content="Forgot password?" Style="{StaticResource LinkButton}" Command="{Binding GoToForgotPasswordCommand}" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding InfoMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,12"/>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="Log In" Style="{StaticResource AccentButton}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Margin="0,0,0,20"/>

            <Grid>
                <TextBlock Text="Need an account?" Opacity="0.7" HorizontalAlignment="Left"/>
                <Button Content="Create one" Style="{StaticResource LinkButton}" Command="{Binding GoToRegisterCommand}" HorizontalAlignment="Right"/>
            </Grid>
            <Button Content="&#8592; Back" Style="{StaticResource LinkButton}" Command="{Binding GoToWelcomeCommand}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
