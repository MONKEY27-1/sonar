<UserControl x:Class="Soundboard.Views.Auth.EmailVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Verify Your Email" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding VerifyEmail, StringFormat='We sent a verification code to {0}. Enter it below to finish setting up your account.'}"
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="Verification code" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding VerifyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                     FontSize="20" HorizontalContentAlignment="Center" CharacterCasing="Upper" MaxLength="8" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding InfoMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8"/>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,16"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="Verify" Style="{StaticResource AccentButton}" Command="{Binding VerifyEmailCodeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Margin="0,0,0,12"/>
            <Button Content="Resend Code" Style="{StaticResource ToolbarButton}" Command="{Binding ResendVerificationCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Margin="0,0,0,20"/>

            <Button Content="&#8592; Back to Log In" Style="{StaticResource LinkButton}" Command="{Binding GoToLoginCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
