<UserControl x:Class="Soundboard.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,24" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Create Account" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Email" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Opacity="0.7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged"
                         Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{DynamicResource BorderBrush}"/>
                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{Binding RegisterPasswordStrength.Score, Converter={StaticResource PasswordStrengthSegment}, ConverterParameter=1}"/>
                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{DynamicResource BorderBrush}"/>
                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{Binding RegisterPasswordStrength.Score, Converter={StaticResource PasswordStrengthSegment}, ConverterParameter=2}"/>
                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{DynamicResource BorderBrush}"/>
                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{Binding RegisterPasswordStrength.Score, Converter={StaticResource PasswordStrengthSegment}, ConverterParameter=3}"/>
                <Border Grid.Column="3" Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                <Border Grid.Column="3" Height="4" CornerRadius="2" Background="{Binding RegisterPasswordStrength.Score, Converter={StaticResource PasswordStrengthSegment}, ConverterParameter=4}"/>
            </Grid>
            <TextBlock Text="{Binding RegisterPasswordStrength.Label}" Opacity="0.6" FontSize="11" Margin="0,0,0,12"/>

            <TextBlock Text="Confirm Password" Opacity="0.7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="RegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged"
                         Style="{StaticResource AuthPasswordBox}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding InfoMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8"/>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="Create Account" Style="{StaticResource AccentButton}" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Margin="0,0,0,16"/>

            <Grid>
                <TextBlock Text="Already have an account?" Opacity="0.7" HorizontalAlignment="Left"/>
                <Button Content="Log in" Style="{StaticResource LinkButton}" Command="{Binding GoToLoginCommand}" HorizontalAlignment="Right"/>
            </Grid>
            <Button Content="&#8592; Back" Style="{StaticResource LinkButton}" Command="{Binding GoToWelcomeCommand}" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
