<Window x:Class="Soundboard.Views.PluginAuthoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a Plugin"
        Width="440"
        Height="600"
        MinWidth="380"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="28" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="Create a Plugin" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Package your current settings into a file you can share — no code, just settings data." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="Name" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Description (optional)" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,16"/>

            <TextBlock Text="Include" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox Content="Hotkeys" IsChecked="{Binding IncludeHotkeys}" Margin="0,0,0,8"/>
            <CheckBox Content="Voice changer presets" IsChecked="{Binding IncludeVoiceChangerPresets}" Margin="0,0,0,8"/>
            <CheckBox Content="Theme" IsChecked="{Binding IncludeTheme}" Margin="0,0,0,20"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,12"/>

            <Button Content="Export Plugin File" Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}"
                    HorizontalAlignment="Left" Width="180" Margin="0,0,0,8"/>

            <TextBlock Text="or make it public — everyone with Sonar can find and import it (starts unverified until an admin reviews it):"
                       Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <Button Content="🌐 Publish Publicly" Style="{StaticResource ToolbarButton}" Command="{Binding PublishCommand}"
                    IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolean}}"
                    HorizontalAlignment="Left" Width="180"/>
        </StackPanel>
    </ScrollViewer>
</Window>
